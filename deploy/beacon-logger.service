# Installed by deploy/install.sh (@USER@ / @REPO@ / @GROUPS@ are substituted).
[Unit]
Description=BEACON station logger (serial instruments -> CSV)
After=local-fs.target bluetooth.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=@GROUPS@
# Raw HCI socket for the HOBO's Bluetooth advertisements (beacon_station/hobo.py):
# BlueZ merges its two packet kinds and loses the temp/RH one.
AmbientCapabilities=CAP_NET_RAW
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 -m beacon_station.logger
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# SIGTERM -> flush and close the CSV cleanly.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
